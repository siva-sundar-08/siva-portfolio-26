# Public URL of the deployed site. Used for metadata, canonical URLs, sitemap and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://sivasundar.world

# FormSubmit target for the contact form. Use the random alias FormSubmit gives you after
# the first activation email, not your raw address: this value ships in the public JS bundle.
# Leave empty in development to log messages to the browser console instead of sending them.
NEXT_PUBLIC_CONTACT_FORMSUBMIT_ID=
